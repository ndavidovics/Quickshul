APP_NAME=QuickShul
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://quickshul.com
ROOT_DOMAIN=quickshul.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quickshul
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.quickshul.com

CACHE_STORE=database
QUEUE_CONNECTION=database

# Google OAuth (member sign-in + admin Gmail connect)
# One Google Cloud app handles both flows
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://quickshul.com/auth/google/callback
GMAIL_REDIRECT_URI=https://quickshul.com/auth/gmail/callback

# QuickBooks Online (platform-level OAuth app — tenants connect their own company)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://quickshul.com/qb/callback
QUICKBOOKS_SCOPE=com.intuit.quickbooks.accounting
QUICKBOOKS_BASE_URL=production

# Super-admin access (comma-separated email addresses)
SUPER_ADMIN_EMAILS=
